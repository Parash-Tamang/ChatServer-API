@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
    ViewData["IsLoginPage"] = true;
}

<h3 class="mx-auto text-center mb-3 fs-3" style="font-family: serif;">Welcome Back</h3>
<div class="login bg-secondary p-5 rounded-4 mx-auto " style=" width:100%;max-width:450px;box-shadow: rgba(50, 50, 93, 0.25) 0px 13px 27px -5px, rgba(0, 0, 0, 0.3) 0px 8px 16px -8px;">
    <form id="loginForm" autocomplete="off">

    <div class="mb-3">
        <label for = "email" class="mb-2">Email address</label>
        <input id="email" type="email" class="form-control shadow-none border border-1 rounded-3 " required />
    </div>
    <div for="password "class="mb-3">
            <label class="mb-2">Password</label>
        <input id="password" type="password" class="form-control shadow-none  border border-1 rounded-3" required />
    </div>
    <div class="text-danger mb-3" id="errorBox" style="display:none"></div>
    <a href="/Account/ForgotPassword"
           class="text-dark text-end  mb-5 d-block">
            Forgot Password?
        </a>
    <button id="loginBtn" class=" bg-dark btn btn-primary w-100 shadow-none border border-0 rounded-pill">Get Started</button>
</form>
</div>
    <a href="/Account/Register"
       class="text-dark text-decoration-none text-center mt-5 d-block">
        Not a member?
        <span class="text-da fw-bold">Register now</span>
</a>

@section Scripts{
    <script src="~/js/login.js" asp-append-version="true"></script>
}
