@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recover Password";
}

<h3 class="mx-auto text-center mb-3 fs-3" style="font-family: serif;">Recover Account</h3>
<div class="login bg-secondary p-5 rounded-4 mx-auto " style=" width:100%;max-width:450px;box-shadow: rgba(50, 50, 93, 0.25) 0px 13px 27px -5px, rgba(0, 0, 0, 0.3) 0px 8px 16px -8px;">
    <form id="forgotPasswordForm" autocomplete="off">
    <div class="mb-3">
        <label for="email" class="mb-2">Email address</label>
        <input id="email" type="email" class="form-control shadow-none border border-1 " required />
    </div>
    <div class="text-danger mb-3" id="errorBox" style="display:none"></div>

    <a href="/Account/Login"
           class="text-dark text-end d-block">
            Back to sign in
        </a>
    <button id="forgotPasswordBtn" class="bg-dark btn btn-primary w-100 p-10 shadow-none border border-0 rounded-pill mt-4">Verify</button>
</form>
</div>
<a href="/Account/Register"
   class="text-dark text-decoration-none text-center mt-5 d-block">
    Not a member?
    <span class="text-dark fw-bold">Register now</span>
</a>
@section Scripts {
    <script src="~/js/forgot.js" asp-append-version="true"></script>
}

