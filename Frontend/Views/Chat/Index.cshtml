@{
    ViewData["Title"] = "TalkToDB Engine";
    Layout = "_Layout";
}
        <header>
            <button class="icon-btn" id="toggle-sidebar">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
            <div class="profile-container">
                <button class="profile-avatar" id="avatar-btn">U</button>
                <div class="dropdown-menu" id="profile-dropdown">
                    <div class="dropdown-item" id="menu-personalize">Settings</div>
                       <div class="dropdown-item" id="menu-test" style="color:red">Test Api</div>
                    <div class="dropdown-item" id="menu-logout" style="color:red">User Logout</div>
                </div>
            </div>
        </header>

        <div id="chat-viewport"></div>

        <div class="input-area">
            <div class="input-pill">
                <textarea id="user-input" placeholder="Ask anything..." rows="1"></textarea>
                <button class="send-btn" id="btn-send" disabled>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                </button>
            </div>
        </div>
   

