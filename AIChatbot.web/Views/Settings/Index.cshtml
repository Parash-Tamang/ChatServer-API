@{
    Layout = "_Layout";
    ViewData["FullPage"] = true;
}


<div class="settings-container">

    <h3>Settings</h3>

    <div class="settings-card">

        <div class="settings-title">User Profile</div>

        <div id="userInfo">
            Loading...
        </div>

        <hr />

        <form id="logoutForm" method="post" asp-action="Logout" asp-controller="Auth" style="display: none;">
        </form>

        <button class="btn btn-danger mt-3" onclick="logout(event)">
            Logout
        </button>

    </div>

</div>

<script src="~/js/settings.js"></script>

<script>
    // ================= LOGOUT FUNCTION =================
    function logout(event) {
        event.preventDefault();
        
        // Show confirmation dialog
        if (confirm("Are you sure you want to logout?")) {
            // Submit the logout form
            document.getElementById("logoutForm").submit();
        }
    }
</script>
