@model AIChatbot.web.Models.RoleManager.CreateRoleRequest
@{
    ViewData["Title"] = "Create Role";
}

<div class="rm-dashboard">
    <div class="rm-header">
        <a href="/RoleManager" class="rm-back">← Back</a>
        <h1>🏷️ Create Role</h1>
    </div>
    <div class="rm-form-card">
        <form method="post" action="/RoleManager/CreateRole">
            @Html.AntiForgeryToken()
            <div class="rm-form-group">
                <label>Role Name</label>
                <input type="text" name="RoleName" class="rm-input" placeholder="e.g. Manager" required />
            </div>
            <div class="rm-form-group">
                <label>Description</label>
                <textarea name="Description" class="rm-input rm-textarea" placeholder="What can this role do?"></textarea>
            </div>
            <div class="rm-form-actions">
                <a href="/RoleManager" class="rm-btn rm-btn--outline">Cancel</a>
                <button type="submit" class="rm-btn rm-btn--primary">Create Role</button>
            </div>
        </form>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="/css/rolemanager.css" />
}