@model AIChatbot.web.Models.RoleManager.CreateAdminRequest
@{
    ViewData["Title"] = "Create Admin";
}

<div class="rm-dashboard">
    <div class="rm-header">
        <a href="/RoleManager" class="rm-back">← Back</a>
        <h1>👤 Create Admin</h1>
    </div>
    <div class="rm-form-card">
        <form method="post" action="/RoleManager/CreateAdmin">
            @Html.AntiForgeryToken()
            <div class="rm-form-group">
                <label>Username</label>
                <input type="text" name="Username" class="rm-input" placeholder="Username" required />
            </div>
            <div class="rm-form-group">
                <label>Email</label>
                <input type="email" name="Email" class="rm-input" placeholder="Email" required />
            </div>
            <div class="rm-form-group">
                <label>Password</label>
                <input type="password" name="Password" class="rm-input" placeholder="Password" required />
            </div>
            <div class="rm-form-actions">
                <a href="/RoleManager" class="rm-btn rm-btn--outline">Cancel</a>
                <button type="submit" class="rm-btn rm-btn--primary">Create Admin</button>
            </div>
        </form>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="/css/rolemanager.css" />
}