@model LoginUser;
@{
    Layout = "_Layout";
    ViewData["FullPage"] = true;
}

<div class="auth-page">

    <div class="auth-card">

        <div class="text-center mb-3">
            <i class="bi bi-robot" style="font-size:32px;"></i>
        </div>

        <div class="auth-title">Welcome back</div>

        <form id="loginForm" method="post" asp-action="Login" asp-controller="Auth">
            @Html.AntiForgeryToken()
            
            <!-- EMAIL -->
         
            <input asp-for="Email"
                   name="email"
                   class="input"
                   type="email"
                   placeholder="Email"
                   autocomplete="username"
                   required />
        

            <!-- PASSWORD -->
            <input asp-for="Password"
                   name="password"
                   class="input"
                   type="password"
                   placeholder="Password"
                   autocomplete="current-password"
                   required />
            <div style="text-align:right; margin-bottom:4px;">
                <a href="/Auth/ForgotPassword" style="font-size:13px; color:#555;">Forgot password?</a>
            </div>

            <!-- LOGIN BUTTON -->
            <button type="submit" class="auth-btn">
                Login
            </button>

        </form>

        <div class="auth-link">
            New user?
            <a href="/Auth/Register">Create account</a>
        </div>

    </div>

</div>
