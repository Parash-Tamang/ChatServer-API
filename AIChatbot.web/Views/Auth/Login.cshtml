@{
    Layout = "_Layout";
    ViewData["FullPage"] = true;
}

<div class="auth-page">

    <div class="auth-card">

        <div class="text-center mb-3">
            <i class="bi bi-robot" style="font-size:32px;"></i>
        </div>

        <div class="auth-title">Welcome back</div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="error" style="margin-bottom: 15px;">
                @ViewData["ErrorMessage"]
            </div>
        }

        <form id="loginForm" method="post" asp-action="Login" asp-controller="Auth">
            
            <!-- EMAIL -->
            <input id="email"
                   name="email"
                   class="input"
                   type="email"
                   placeholder="Email"
                   autocomplete="username"
                   required />
            @if (ViewData["EmailError"] != null)
            {
                <small class="error">@ViewData["EmailError"]</small>
            }

            <!-- PASSWORD -->
            <input id="password"
                   name="password"
                   class="input"
                   type="password"
                   placeholder="Password"
                   autocomplete="current-password"
                   required />
            @if (ViewData["PasswordError"] != null)
            {
                <small class="error">@ViewData["PasswordError"]</small>
            }

            <!-- RETURN URL (Hidden) -->
            @if (ViewData["ReturnUrl"] != null)
            {
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            }

            <!-- LOGIN BUTTON -->
            <button type="submit" class="auth-btn">
                Login
            </button>

        </form>

        <div class="auth-link">
            New user?
            <a href="/Auth/Register">Create account</a>
        </div>

    </div>

</div>
