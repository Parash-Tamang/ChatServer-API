@using AIChatbot.web.Models.Auth
@model ForgotPasswordModel

@{
    Layout = "_Layout";
    ViewData["FullPage"] = true;
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-3">
            <i class="bi bi-envelope-open" style="font-size:32px;"></i>
        </div>
        <div class="auth-title">Forgot password</div>
        <p class="auth-subtitle">Enter your email and we'll send you a 6-digit OTP.</p>

        <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
            @Html.AntiForgeryToken()

            <input asp-for="Email"
                   name="email"
                   class="input"
                   type="email"
                   placeholder="Email address"
                   autocomplete="email"
                   required />
           

            <button type="submit" class="auth-btn">Send OTP</button>
        </form>

        <div class="auth-link">
            Remembered it? <a href="/Auth/Login">Back to login</a>
        </div>
    </div>
</div>