@model List<AIChatbot.web.Dto.ConnectionRequestDto>
@{
    Layout = "_AdminLayout";
}

<!-- Connection List -->
<div class="container-fluid mb-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Database Connections</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-plug fs-1"></i>
                            <p class="mt-2">No connections found. Add one below.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Server</th>
                                    <th>Database</th>
                                    <th>Auth Mode</th>
                                    <th>Timeout</th>
                                    <th>Knowledge Base</th>
                                    <th>Active</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="connectionsTableBody">
                                @foreach (var conn in Model)
                                {
                                    @await Html.PartialAsync("_ConnectionTableRow", conn)
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add New Connection Form -->
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Add New Connection</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">-
                        <div class="d-flex gap-3 mb-1">
                            <label class="form-label fw-semibold flex-fill mb-0">Server Name</label>
                            <label class="form-label fw-semibold flex-fill mb-0">Database Name</label>
                        </div>
                        <div class="d-flex gap-3">
                            <input type="text" id="ServerName" name="ServerName" class="form-control" required />
                            <input type="text" id="DatabaseName" name="DatabaseName" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Authentication Type</label>
                        <div class="d-flex gap-3 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="AuthMode" value="Sql" id="sqlAuth" checked />
                                <label class="form-check-label">SQL Authentication</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="AuthMode" value="Windows" id="windowsAuth" />
                                <label class="form-check-label">Windows Authentication</label>
                            </div>
                        </div>
                    </div>
                    <div id="sqlCredentials">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Username</label>
                            <input type="text" id="Username" name="Username" class="form-control" placeholder="sa" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" id="Password" name="Password" class="form-control" placeholder="Enter password" />
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-4">
                        <div class="flex-fill">
                            <label class="form-label fw-semibold">Connection Timeout <span class="text-muted fw-normal">(seconds)</span></label>
                            <input type="number" id="ConnectionTimeout" name="ConnectionTimeout" class="form-control" value="30" min="0" max="300" />
                        </div>
                        <div class="flex-fill d-flex flex-column justify-content-end pb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="TrustCertificate" name="TrustCertificate" value="true" checked />
                                <label class="form-check-label fw-semibold" for="TrustCertificate">Trust Server Certificate</label>
                            </div>
                            <small class="text-muted">Recommended for local/dev servers</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" id="saveConnectionBtn" class="btn btn-primary">Test & Save Connection</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_EditConnectionModal", new AIChatbot.web.Dto.ConnectionRequestDto())

@section Scripts {
    <script src="~/js/database-connection.js "asp-append-version="true"></script>
}