@model List<AIChatbot.web.Dto.ConnectionRequestDto>
@{
    Layout = "_AdminLayout";
}

<!-- Connection List -->
<div class="container-fluid mb-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Database Connections</h5>
                    <div>
                        <button type="button" id="openAddConnectionBtn" class="btn btn-sm btn-outline-primary">+ Add New Connection</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-plug fs-1"></i>
                            <p class="mt-2">No connections found. Add one below.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Server</th>
                                    <th>Database</th>
                                    <th>Auth Mode</th>
                                    <th>Timeout</th>
                                    <th>Knowledge Base</th>
                                    <th>Active</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="connectionsTableBody">
                                @foreach (var conn in Model)
                                {
                                    @await Html.PartialAsync("_ConnectionTableRow", conn)
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_EditConnectionModal", new AIChatbot.web.Dto.ConnectionRequestDto())

@section Scripts {
    <script src="~/js/database-connection.js "asp-append-version="true"></script>
}