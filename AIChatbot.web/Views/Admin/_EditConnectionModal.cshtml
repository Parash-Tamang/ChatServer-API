@model AIChatbot.web.Dto.ConnectionRequestDto

<div class="modal fade" id="editModal" tabindex="-1" data-mode="edit">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="connectionModalTitle">Edit Connection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" name="id" />
                <div class="mb-3">
                    <div class="d-flex gap-3 mb-1">
                        <label class="form-label fw-semibold flex-fill mb-0">Server Name</label>
                        <label class="form-label fw-semibold flex-fill mb-0">Database Name</label>
                    </div>
                    <div class="d-flex gap-3">
                        <input type="text" id="editServer" name="serverName" class="form-control" required />
                        <input type="text" id="editDatabase" name="databaseName" class="form-control" required />
                    </div>
                </div>
                <div id="editSqlCredentials">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Username</label>
                        <input type="text" id="editUsername" name="username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input type="password" id="editPassword" name="password" class="form-control" placeholder="Enter password" required />
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <div class="flex-fill">
                        <label class="form-label fw-semibold">Timeout (seconds)</label>
                        <input type="number" id="editTimeout" name="connectionTimeout" class="form-control" min="0" max="300" required />
                    </div>
                    <div class="flex-fill d-flex flex-column justify-content-end pb-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="editTrust" name="trustCertificate" checked />
                            <label class="form-check-label fw-semibold">Trust Certificate</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveEditBtn" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </div>
</div>