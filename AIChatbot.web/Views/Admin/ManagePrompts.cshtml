@model AIChatbot.web.Models.Admin.ManagePromptsViewModel
@{
    Layout = "_AdminLayout";
    var globalPrompt = Model.GlobalPrompts.FirstOrDefault();
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="row g-3">

                <!-- DB List Panel -->
                <div class="col-12 col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">Databases</h6>
                        </div>
                        <div class="card-body p-0">
                            @if (!Model.Connections.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-database fs-3"></i>
                                    <p class="mt-2 small">No databases found</p>
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush" id="dbList">

                                    <!-- Global entry -->
                                    <li class="list-group-item list-group-item-action db-item d-flex align-items-center gap-2"
                                        data-id="global"
                                        style="cursor:pointer;">
                                        <i class="bi bi-globe small text-primary"></i>
                                        <div>
                                            <div class="fw-semibold small">Global</div>
                                            <div class="text-muted" style="font-size:0.75rem;">All databases</div>
                                        </div>
                                    </li>

                                    @foreach (var conn in Model.Connections)
                                    {
                                        <li class="list-group-item list-group-item-action db-item d-flex align-items-center gap-2"
                                            data-id="@conn.Id"
                                            data-name="@conn.DatabaseName"
                                            data-promptmode="@conn.PromptingMode"
                                            style="cursor:pointer;">
                                            <i class="bi bi-circle-fill small @(conn.IsActive ? "text-success" : "text-secondary")"></i>
                                            <div>
                                                <div class="fw-semibold small">@conn.DatabaseName</div>
                                                <div class="text-muted" style="font-size:0.75rem;">@conn.ServerName</div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>

                <!-- Prompts Panel -->
                <div class="col-12 col-md-9">

                    <!-- Function List -->
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="bi bi-list-ul me-2"></i>Functions
                                <span id="selectedDbName" class="text-muted fw-normal small ms-1"></span>
                            </h6>
                            <button class="btn btn-primary btn-sm d-none" id="newFunctionBtn">
                                    <i class="bi bi-plus-lg me-1"></i>New
                            </button>
                        </div>
                        <div class="card-body" id="functionListPanel">
                            <div class="text-center text-muted py-3">
                                <i class="bi bi-hand-index fs-3"></i>
                                <p class="mt-2 small">Select Global or a database to view functions</p>
                            </div>
                        </div>
                    </div>

                    <!-- Prompt Editor -->
                    <div class="card shadow-sm" id="editorCard" style="display:none;">
                        <div class="card-header bg-white">
                            <h6 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Prompt Editor</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label fw-semibold">Function Name</label>
                                <input type="text" id="editorFunctionName" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">System Prompt</label>
                                <textarea id="editorSystemPrompt" class="form-control" rows="6"></textarea>
                            </div>

                            <!-- Prompting Mode — only shown for DB context -->
                            <div class="mb-3" id="promptModeSection" style="display:none;">
                                <label class="form-label fw-semibold d-block">Prompting Mode</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="promptMode" id="modeGlobal" value="0" />
                                    <label class="form-check-label" for="modeGlobal">Global</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="promptMode" id="modeLocal" value="1" />
                                    <label class="form-check-label" for="modeLocal">Local</label>
                                </div>
                            </div>

                            <input type="hidden" id="editorFunctionId" />
                            <input type="hidden" id="editorContext" />

                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-outline-secondary btn-sm" id="savePromptModeBtn" style="display:none;">
                                    <i class="bi bi-toggles me-1"></i> Save Mode
                                </button>
                                <button class="btn btn-primary btn-sm" id="savePromptBtn">
                                    <i class="bi bi-save me-1"></i> Save Prompt
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-prompts.js" asp-append-version="true"></script>
}