@model AIChatbot.web.Models.Admin.ManagePromptsViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="row g-3">

                <!-- DB List Panel -->
                <div class="col-12 col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">Databases</h6>
                        </div>
                        <div class="card-body p-0">
                            @if (!Model.Connections.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-database fs-3"></i>
                                    <p class="mt-2 small">No databases found</p>
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush" id="dbList">
                                    @foreach (var conn in Model.Connections)
                                    {
                                        <li class="list-group-item list-group-item-action db-item d-flex align-items-center gap-2"
                                            data-id="@conn.Id"
                                            style="cursor:pointer;">
                                            <i class="bi bi-circle-fill small @(conn.IsActive ? "text-success" : "text-secondary")"></i>
                                            <div>
                                                <div class="fw-semibold small">@conn.DatabaseName</div>
                                                <div class="text-muted" style="font-size:0.75rem;">@conn.ServerName</div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>

                <!-- Prompts Panel -->
                <div class="col-12 col-md-9">

                    <!-- Global Prompts -->
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-white">
                            <h6 class="mb-0"><i class="bi bi-globe me-2"></i>Global Prompts</h6>
                        </div>
                        <div class="card-body">
                            @if (!Model.GlobalPrompts.Any())
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-chat-square-dots fs-3"></i>
                                    <p class="mt-2 small">No global prompts found</p>
                                </div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    @foreach (var prompt in Model.GlobalPrompts)
                                    {
                                        <div class="col-12 col-md-6">
                                            <div class="card border h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title fw-semibold">@prompt.FunctionName</h6>
                                                    <p class="card-text text-muted small">@prompt.SystemPrompt</p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Local Prompts -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="bi bi-database me-2"></i>
                                Local Prompts
                                <span id="selectedDbName" class="text-muted fw-normal small ms-1"></span>
                            </h6>
                        </div>
                        <div class="card-body" id="localPromptsPanel">
                            <div class="text-center text-muted py-3">
                                <i class="bi bi-hand-index fs-3"></i>
                                <p class="mt-2 small">Select a database to view local prompts</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Embed local prompts data from server
        const localPromptsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocalPrompts));
        const connections = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Connections));

        document.querySelectorAll('.db-item').forEach(item => {
            item.addEventListener('click', function () {
                // Highlight selected
                document.querySelectorAll('.db-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');

                const id = this.dataset.id;
                const conn = connections.find(c => c.id === id);
                const prompts = localPromptsData[id] || [];

                // Update header
                document.getElementById('selectedDbName').textContent = `— ${conn?.databaseName ?? ''}`;

                // Render local prompts
                const panel = document.getElementById('localPromptsPanel');

                if (prompts.length === 0) {
                    panel.innerHTML = `
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox fs-3"></i>
                            <p class="mt-2 small">No local prompts for this database</p>
                        </div>`;
                } else {
                    panel.innerHTML = `
                        <div class="row g-2">
                            ${prompts.map(p => `
                                <div class="col-12 col-md-6">
                                    <div class="card border h-100">
                                        <div class="card-body">
                                            <h6 class="card-title fw-semibold">${p.functionName}</h6>
                                            <p class="card-text text-muted small">${p.systemPrompt}</p>
                                        </div>
                                    </div>
                                </div>`).join('')}
                        </div>`;
                }
            });
        });
    </script>
}