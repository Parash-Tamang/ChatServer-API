@using AIChatbot.web.Models.Chat
@model ChatPageModel
@{
    Layout = "_Layout";
}

    @section Styles {
        <link rel="stylesheet" href="~/css/sql-connection.css" />
        <style>
            /* ── typing indicator ── */
            .typing-indicator {
                display: flex;
                gap: 5px;
                padding: 12px 16px;
                align-items: center;
            }

                .typing-indicator span {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #aaa;
                    display: inline-block;
                    animation: bounce 1.2s infinite ease-in-out;
                }

                    .typing-indicator span:nth-child(2) {
                        animation-delay: 0.2s;
                    }

                    .typing-indicator span:nth-child(3) {
                        animation-delay: 0.4s;
                    }

            @@keyframes bounce {
                0%, 80%, 100% {
                    transform: scale(0.7);
                    opacity: 0.5;
                }

                40% {
                    transform: scale(1.1);
                    opacity: 1;
                }
            }

            /* ── session active state ── */
            .session-item.active {
                background: rgba(255,255,255,0.12);
                border-radius: 8px;
            }

        /* ── send button spinner ── */
        .btn-send-loading {
            opacity: 0.6;
            pointer-events: none;
        }
    </style>
}

<div class="app-body">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <div class="sidebar">

        <div class="sidebar-top">
            <button id="btnNewChat" class="btn btn-light new-chat-btn">+ New Chat</button>
        </div>

        <div class="sidebar-top">Chats</div>

        <!-- Sessions list – filled by JS -->
        <div class="session-list" id="sessionList">
            <div class="text-muted p-2 text-center small" id="sessionsPlaceholder">Loading…</div>
        </div>

        <!-- Bottom user -->
        <div class="sidebar-bottom">
            <div>@Model.UserName</div>
            <div class="dropdown">
                <i class="bi bi-three-dots-vertical" data-bs-toggle="dropdown" style="cursor:pointer;"></i>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/Settings/Index">Settings</a></li>

                    <li>
                        <a class="dropdown-item" asp-controller="Admin" asp-action="DatabaseConnections">
                            Admin Connection
                        </a>
                    </li>

                    <li>
                        <button type="button" class="dropdown-item" onclick="loadRoleManagerModal()">Rolemanager</button>
                   
                    </li>

                    <li>
                        <button type="button" class="dropdown-item" onclick="loadDbModal()">ManageDB</button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" asp-action="Logout" asp-controller="Auth" style="display:inline;">
                            <button type="submit" class="dropdown-item text-danger"
                                    onclick="return confirm('Are you sure you want to logout?');">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ══════════════ CHAT AREA ══════════════ -->
    <div class="chat-area">

        <!-- Messages container -->
        <div class="messages" id="messagesContainer">
            <div class="text-center mt-5 text-muted" id="emptyState">
                <h5>Start a conversation</h5>
                <div>Ask anything. The AI is ready.</div>
            </div>
        </div>

        <!-- Input -->
        <div class="chat-input">
            <div class="input-group">
                <textarea id="messageInput"
                          class="form-control"
                          rows="1"
                          placeholder="Type your message…"
                          autocomplete="off"></textarea>
                <button id="sendBtn" class="btn btn-dark">
                    <i class="bi bi-send" id="sendIcon"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Modal panel -->
    <div id="manageDbPanel" class="manage-db-panel">
        <div class="manage-db-content">
            <div id="modalContainer"></div>
        </div>
    </div>
</div>
<!--For showing erros /flag for connection string -->
<span id="dbConnectionFlag" class="db-connection-flag d-none">
    <i class="bi bi-database-fill"></i>
    <span id="dbConnectionLabel"></span>
    <button type="button" id="disconnectDb" class="db-flag-close" title="Disconnect">
        <i class="bi bi-x"></i>
    </button>
</span>



@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="~/js/chatmessage.js"></script>
    <script src="~/js/connection.js"></script>
    <form id="__AjaxAntiForgery" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
}
