@using AIChatbot.web.Models.Chat
@model ChatPageModel
@{
    Layout = "_Layout";
}

<div class="app-body">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <!-- Top -->
        <div class="sidebar-top">
            <form method="post" asp-action="NewChat" asp-controller="Chat" style="display: inline;">
                <button type="submit" class="btn btn-dark new-chat-btn">
                    + New Chat
                </button>
            </form>
        </div>

        <div class="sidebar-top">
            Chats
        </div>

        <!-- Sessions List -->
        <div class="session-list">
            @if (Model.Sessions != null && Model.Sessions.Count > 0)
            {
                @foreach (var session in Model.Sessions)
                {
                    <div class="session-item d-flex justify-content-between align-items-center">
                        <form method="post" asp-action="OpenSession" asp-controller="Chat" style="flex: 1; margin: 0;">
                            <input type="hidden" name="sessionId" value="@session.Id" />
                            <button type="submit" class="btn btn-link session-title" 
                                    style="color: inherit; text-decoration: none; text-align: left; padding: 8px;">
                                @(string.IsNullOrWhiteSpace(session.TopicName) ? "New Chat" : session.TopicName)
                            </button>
                        </form>

                        <div class="dropdown">
                            <i class="bi bi-three-dots-vertical"
                               data-bs-toggle="dropdown"
                               style="cursor:pointer"></i>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form method="post" asp-action="DeleteSession" asp-controller="Chat" style="display: inline;">
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <button type="submit" class="dropdown-item text-danger" 
                                                onclick="return confirm('Delete this chat?');">
                                            Delete
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted p-2">No chats yet. Start a new one!</div>
            }
        </div>

        <!-- Bottom user -->
        <div class="sidebar-bottom">
            <div>@Model.UserName</div>

            <div class="dropdown">
                <i class="bi bi-three-dots-vertical"
                   data-bs-toggle="dropdown"
                   style="cursor:pointer;"></i>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="/Settings/Index">
                            Settings
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li>
                        <form method="post" asp-action="Logout" asp-controller="Auth" style="display: inline;">
                            <button type="submit" class="dropdown-item text-danger" 
                                    onclick="return confirm('Are you sure you want to logout?');">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>

    </div>

    <!-- CHAT AREA -->
    <div class="chat-area">

        <!-- Messages -->
        <div class="messages">
            @if (Model.CurrentSessionMessages != null && Model.CurrentSessionMessages.Count > 0)
            {
                @foreach (var message in Model.CurrentSessionMessages)
                {
                    <div class="d-flex flex-column @(message.Role == "user" ? "align-items-end" : "align-items-start")">
                        <div class="msg @(message.Role == "user" ? "user" : "bot")">
                            @message.Content
                        </div>
                        <div class="msg-time">
                            @(message.CreatedAt != default ? message.CreatedAt.ToString("HH:mm") : "")
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center mt-5 text-muted">
                    <h5>Start a conversation</h5>
                    <div>Ask anything. The AI is ready.</div>
                </div>
            }
        </div>

        <!-- INPUT FORM -->
        <div class="chat-input">
            <form method="post" asp-action="SendMessage" asp-controller="Chat">
                <input type="hidden" name="chatSessionId" value="@Model.CurrentSessionId" />

                <div class="input-group">
                    <textarea name="message"
                              class="form-control"
                              rows="1"
                              placeholder="Type your message..."
                              autocomplete="off"
                              required></textarea>

                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </form>
        </div>

    </div>

</div>
